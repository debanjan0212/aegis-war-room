# Copy this file to .env and fill in only what you use. .env is in .gitignore, so your keys are never committed.
# The aegis command reads .env by itself. Anything already set in your terminal wins.

# --- General -----------------------------------------------------------------
# AEGIS_ASSISTANT_NAME=Aegis        # the name on screen and in the voice
# AEGIS_OPERATOR_NAME=               # your name: Aegis greets you with it ("Good evening, Debanjan")
# AEGIS_MODEL=offline               # default for the model toggle (and for the live watcher): offline, local, azure, bedrock or vertex
# AEGIS_PACE=0.8                    # seconds between agent messages, so people can follow. 0 = instant
# AEGIS_API_TOKEN=                  # set this whenever the war room is reachable by other machines
# AEGIS_HOST=127.0.0.1              # 127.0.0.1 = this machine only (the safe default)
# AEGIS_PORT=8000

# --- Model toggle: a model on this laptop (Ollama) --------------------------------
# OLLAMA_MODEL=qwen2.5:7b           # run `ollama pull <this>` first. Check with: aegis models --test
# OLLAMA_HOST=http://127.0.0.1:11434   # only if Ollama runs somewhere else

# --- Model toggle: Azure OpenAI ------------------------------------------------
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# OPENAI_API_VERSION=

# --- Model toggle: AWS Bedrock (uses your normal AWS login or keys) -------------
# BEDROCK_MODEL_ID=
# AWS_REGION=

# --- Model toggle: Google Vertex AI (uses `gcloud auth application-default login`) ---
# VERTEX_MODEL=
# GOOGLE_CLOUD_PROJECT=

# --- Live mode: the OpenTelemetry Demo shop -------------------------------------
# AEGIS_SOURCE=otel-demo
# PROMETHEUS_URL=http://localhost:9090
# OTEL_DEMO_FLAG_FILE=/path/to/opentelemetry-demo/src/flagd/demo.flagd.json
# AEGIS_VERIFY_TRIES=15             # after a fix, check the numbers this many times...
# AEGIS_VERIFY_WAIT=10              # ...waiting this many seconds between checks
# AEGIS_WATCH_EVERY=20              # look at the live system by itself every N seconds (0 = only when you press scan)
# AEGIS_WATCH_QUIET=180             # after an incident, wait this long before opening another for the same service
# `make live` sets the live-mode settings above for you.
